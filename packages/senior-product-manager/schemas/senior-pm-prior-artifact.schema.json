{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schemaVersion","specId","slug","hostIdentifier","revision","base"],"properties":{"schemaVersion":{"const":"1.0.0"},"specId":{"$ref":"#/$defs/id"},"slug":{"type":"string","minLength":1,"maxLength":120,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"hostIdentifier":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":1},"base":{"type":"string","maxLength":240,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*\\.r[0-9]+$"}},"$defs":{"id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[^/\\\\]+$"}}}
