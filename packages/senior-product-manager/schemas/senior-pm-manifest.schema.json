{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schemaVersion","specId","revision","status","canonicalContentHash","committed","files"],"properties":{"schemaVersion":{"const":"1.0.0"},"specId":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[^/\\\\]+$"},"revision":{"type":"integer","minimum":1},"status":{"enum":["Draft","Blocked by product decision","Ready for design review","Ready for technical planning","Ready for implementation","Returned for product revision"]},"canonicalContentHash":{"$ref":"#/$defs/hash"},"committed":{"const":true},"files":{"type":"object","additionalProperties":false,"required":["canonicalJson","markdown","handoffJson"],"properties":{"canonicalJson":{"$ref":"#/$defs/hash"},"markdown":{"$ref":"#/$defs/hash"},"handoffJson":{"$ref":"#/$defs/hash"},"designReview":{"$ref":"#/$defs/persisted"},"priorArtifact":{"$ref":"#/$defs/persisted"}}}},"$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"persisted":{"type":"object","additionalProperties":false,"required":["file","sha256"],"properties":{"file":{"type":"string","minLength":1,"maxLength":240,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*\\.r[0-9]+\\.(design-review|prior-artifact)\\.json$"},"sha256":{"$ref":"#/$defs/hash"}}}}}
