{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:senior-pm:schema:design-review:1.0.0","type":"object","additionalProperties":false,"required":["schemaVersion","specId","revision","productContentHash","decision","reviewer","reviewedAt","evidence"],"properties":{"schemaVersion":{"const":"1.0.0"},"specId":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":1},"productContentHash":{"$ref":"#/$defs/hash"},"decision":{"enum":["approved","changes_requested"]},"reviewer":{"type":"object","additionalProperties":false,"required":["id","name"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/id"},"role":{"$ref":"#/$defs/id"}}},"reviewedAt":{"type":"string","format":"date-time"},"evidence":{"type":"string","minLength":1,"maxLength":20000}},"$defs":{"id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[^/\\\\]+$"},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
