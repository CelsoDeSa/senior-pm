{
  "name": "senior-pm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('Publication is disabled for this source preview'); process.exit(1)\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:gate-policy": "node scripts/test-hosted-checkout-policy.mjs",
    "test": "npm run test:gate-policy && npm run test --workspaces --if-present",
    "matrix:opencode": "node scripts/run-opencode-matrix.mjs",
    "validate:known-legacy": "node scripts/validate-known-legacy.mjs",
    "gate:a": "node scripts/run-gate.mjs A",
    "gate:a:hosted": "node scripts/run-gate.mjs A --mode hosted",
    "gate:b": "node scripts/run-gate.mjs B",
    "gate:c": "node scripts/run-gate.mjs C",
    "gate:d": "node scripts/run-gate.mjs D",
    "gates": "npm run gate:a && npm run gate:b && npm run gate:c && npm run gate:d"
  }
}
